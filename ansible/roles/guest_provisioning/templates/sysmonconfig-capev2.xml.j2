<!--
  CAPEv2 Sysmon Configuration
  Generated by Ansible — {{ ansible_date_time.iso8601 | default('N/A') }}

  Tuned for malware analysis: captures process, network, DNS, registry,
  and file events that CAPEv2's processing modules (network_etw.py,
  evtx.py) consume for behavioral analysis and network attribution.
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  <CheckRevocation>False</CheckRevocation>
  <EventFiltering>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 1: ProcessCreate
         Provides process lineage (parent image) for behavioral analysis.
         ════════════════════════════════════════════════════════════════ -->
    <ProcessCreate onmatch="exclude">
      <!-- Exclude Windows servicing and update processes -->
      <Image condition="is">C:\Windows\System32\MusNotification.exe</Image>
      <Image condition="is">C:\Windows\System32\MusNotifyIcon.exe</Image>
      <Image condition="is">C:\Windows\System32\UsoClient.exe</Image>
      <Image condition="is">C:\Windows\System32\TiWorker.exe</Image>
      <Image condition="is">C:\Windows\System32\wsqmcons.exe</Image>
      <!-- Exclude Sysmon itself to reduce noise -->
      <Image condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon.exe</Image>
      <Image condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon64.exe</Image>
    </ProcessCreate>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 3: NetworkConnect
         Source of network attribution data in network_etw.py.
         ════════════════════════════════════════════════════════════════ -->
    <NetworkConnect onmatch="exclude">
      <!-- Exclude Windows Update and telemetry -->
      <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      <Image condition="is">C:\Windows\System32\MusNotification.exe</Image>
      <Image condition="is">C:\Windows\System32\UsoClient.exe</Image>
      <!-- Exclude Sysmon itself -->
      <Image condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon.exe</Image>
      <Image condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon64.exe</Image>
      <!-- Exclude common local connections -->
      <DestinationIp condition="is">127.0.0.1</DestinationIp>
      <DestinationIp condition="is">::1</DestinationIp>
    </NetworkConnect>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 7: ImageLoaded
         DLL loads for detection and correlation.
         ════════════════════════════════════════════════════════════════ -->
    <ImageLoaded onmatch="exclude">
      <!-- Exclude signed Windows system DLLs -->
      <Signed condition="is">true</Signed>
      <ImageLoaded condition="begin with">C:\Windows\System32\</ImageLoaded>
      <ImageLoaded condition="begin with">C:\Windows\SysWOW64\</ImageLoaded>
      <ImageLoaded condition="begin with">C:\Windows\WinSxS\</ImageLoaded>
    </ImageLoaded>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 8: CreateRemoteThread
         Injection detection — always log, no exclusions.
         ════════════════════════════════════════════════════════════════ -->
    <CreateRemoteThread onmatch="exclude">
    </CreateRemoteThread>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 10: ProcessAccess
         Process hollowing and credential access detection.
         ════════════════════════════════════════════════════════════════ -->
    <ProcessAccess onmatch="exclude">
      <!-- Exclude Sysmon reading its own target -->
      <SourceImage condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon.exe</SourceImage>
      <SourceImage condition="is">{{ sysmon_install_dir | default('C:\\Sysmon') }}\Sysmon64.exe</SourceImage>
      <!-- Exclude common benign access patterns -->
      <SourceImage condition="is">C:\Windows\System32\csrss.exe</SourceImage>
      <SourceImage condition="is">C:\Windows\System32\lsass.exe</SourceImage>
      <SourceImage condition="is">C:\Windows\System32\wininit.exe</SourceImage>
    </ProcessAccess>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 11: FileCreate
         Tracks file drops — critical for payload analysis.
         ════════════════════════════════════════════════════════════════ -->
    <FileCreate onmatch="exclude">
      <!-- Exclude Windows Update and temp noise -->
      <TargetFilename condition="begin with">C:\Windows\Temp\~</TargetFilename>
      <TargetFilename condition="end with">.tmp</TargetFilename>
      <TargetFilename condition="begin with">C:\Windows\SoftwareDistribution\</TargetFilename>
    </FileCreate>

    <!-- ════════════════════════════════════════════════════════════════
         Event IDs 12, 13, 15: RegistryEvent
         Persistence and configuration detection.
         ════════════════════════════════════════════════════════════════ -->
    <RegistryEvent onmatch="exclude">
      <!-- Exclude high-volume benign registry noise -->
      <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders</TargetObject>
      <TargetObject condition="begin with">HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders</TargetObject>
      <TargetObject condition="begin with">HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Stream</TargetObject>
      <TargetObject condition="end with">AppXStaging</TargetObject>
    </RegistryEvent>

    <!-- ════════════════════════════════════════════════════════════════
         Event ID 22: DnsQuery
         DNS attribution data for network_etw.py.
         ════════════════════════════════════════════════════════════════ -->
    <DnsQuery onmatch="exclude">
      <!-- Exclude Windows Update and telemetry DNS -->
      <QueryName condition="end with">.windowsupdate.com</QueryName>
      <QueryName condition="end with">.microsoft.com</QueryName>
      <QueryName condition="end with">.update.microsoft.com</QueryName>
      <QueryName condition="end with">.delivery.mp.microsoft.com</QueryName>
      <QueryName condition="end with">.windows.com</QueryName>
    </DnsQuery>

    <!-- ════════════════════════════════════════════════════════════════
         Event IDs 23, 26: FileDelete (archived)
         Tracks file deletion — useful for anti-forensics detection.
         ════════════════════════════════════════════════════════════════ -->
    <FileDelete onmatch="exclude">
      <TargetFilename condition="begin with">C:\Windows\Temp\</TargetFilename>
      <TargetFilename condition="end with">.tmp</TargetFilename>
    </FileDelete>

  </EventFiltering>
</Sysmon>
