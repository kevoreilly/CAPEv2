# CAPE Web UI (Granian WSGI) configuration overrides
# Un-comment the variables you want to change and run: sudo systemctl restart cape-web

# Bind address (use 127.0.0.1 when serving behind Nginx)
#GRANIAN_HOST=127.0.0.1
#GRANIAN_PORT=8000

# Worker processes and blocking threads per worker (Django WSGI runs on blocking threads)
#GRANIAN_WORKERS=4
#GRANIAN_BLOCKING_THREADS=4

# Worker recycling limits (MiB RSS / seconds lifetime)
#GRANIAN_WORKERS_MAX_RSS=1024
#GRANIAN_WORKERS_LIFETIME=3600

# Graceful drain timeout before SIGKILL during reload/stop (seconds)
#GRANIAN_WORKERS_KILL_TIMEOUT=30

# Granian log level: critical, error, warning, info, debug
#GRANIAN_LOG_LEVEL=info

# Optional: Prometheus metrics endpoint (127.0.0.1:9090 by default)
#GRANIAN_METRICS_ENABLED=true
#GRANIAN_METRICS_PORT=9090
