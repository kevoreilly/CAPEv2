# Guacamole ASGI (Granian) configuration overrides
# Un-comment the variables you want to change and run: sudo systemctl restart guac-web

# Bind address and port (proxied by Nginx /guac/)
#GRANIAN_HOST=127.0.0.1
#GRANIAN_PORT=8008

# Worker processes
#GRANIAN_WORKERS=4

# Graceful drain timeout before SIGKILL during reload/stop (seconds)
#GRANIAN_WORKERS_KILL_TIMEOUT=30

# Granian log level: critical, error, warning, info, debug
#GRANIAN_LOG_LEVEL=info
