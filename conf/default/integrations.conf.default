# This config is to be able to enable/disable things like MSI/NSIS/UnAutoIt, 3rd part services integraitons, etc

[general]
pefiles = yes
dotnet = no
office = no
java = no
pdf = no
lnk = no
windows_script = no
elf = no
hwp = no

# Number of workers for pool to run them in parallel
max_workers = 6

# Create your apikey: https://threatfox.abuse.ch/api/#auth_key
# MalwareBazaar uses this key too
[abusech]
threatfox = no
malwarebazaar = no
apikey =


# sudo apt install msitools
[msi_extract]
enabled = yes
binary = /usr/bin/msiextract
timeout = 60

[kixtart_extract]
enabled = yes
timeout = 60

[vbe_extract]
enabled = yes
timeout = 60

[batch_extract]
enabled = yes
timeout = 60

# REPO DOESN'T EXIST ANYMORE!
# cd /opt/CAPEv2/data/
# snap install go --classic
# git clone https://github.com/x0r19x91/UnAutoIt && cd UnAutoIt
# GOOS="linux" GOARCH="amd64" go build -o UnAutoIt
[UnAutoIt_extract]
enabled = yes
binary = data/UnAutoIt/UnAutoIt
timeout = 60

[RarSFX_extract]
enabled = yes
timeout = 60

# apt install upx-ucl
[UPX_unpack]
enabled = yes
timeout = 60

# Nsis, 7Zip SFX, etc
[SevenZip_unpack]
binary = data/7zz
enabled = yes
timeout = 60

# Use https://github.com/gdesmar/innoextract
[Inno_extract]
enabled = yes
binary = data/innoextract
timeout = 60

# https://github.com/mstrobel/procyon/releases
[procyon]
enabled = yes
binary = data/procyon.jar
timeout = 60

# sudo apt install de4dot
[de4dot_deobfuscate]
enabled = yes
binary = /usr/bin/de4dot
extra_args =
timeout = 60

# https://github.com/otavepto/NETReactorSlayer/releases
[eziriz_deobfuscate]
enabled = yes
binary = data/NETReactorSlayer.CLI
extra_args = --no-pause True
timeout = 60

[office_one]
enabled = yes
timeout = 60

[msix_extract]
enabled = no
timeout = 60

# PE file overlay
[overlay]
enabled = yes
timeout = 60

[UnGPG_extract]
enabled = no
timeout = 60

[pyinstaller]
enabled = no
timeout = 60

# Community
# FLARE capa -> to update rules: poetry run python utils/community.py -cr
[flare_capa]
enabled = no
# Generate it always or generate on demand only(user need to click button to generate it), still should be enabled to use this feature on demand
on_demand = no
# Analyze binary payloads
static = no
# Analyze CAPE payloads
cape = no
# Analyze ProcDump
procdump = no
# behavior analysis summary
behavior = no
# Use Malcat's CAPA instead of FLARE capa (requires the Malcat bridge and
# [malcat] enabled in processing.conf). Malcat's CAPA is significantly faster
# and is rendered in the SAME 'View CAPA' panel (same output shape); it may
# populate fewer rows in some sections. When yes, it overrides FLARE capa
# wherever FLARE capa would run (static / cape payloads / procdump).
malcat_capa = no

# external download services
[downloaders]
# You can overwrite the downloaders order, must match filename without ".py". If name is missed is the same as disabled. Example:
# order = virustotal,malwarebazaar
order =

[virustotal]
enabled = no
apikey =

# Community
[floss]
enabled = no
on_demand = yes
static_strings = no
stack_strings = yes
decoded_strings = yes
tight_strings = yes
min_length = 5
# Download FLOSS signatures from https://github.com/mandiant/flare-floss/tree/master/sigs
sigs_path = data/flare-signatures

# Code-similarity engines
# Enable too in processing.conf. 
# We recommend ensuring local similairty engines such as mcrit are populated with unpacked samples ideally aquired from CAPE payloads/procdumps or are not heavily packed/obfuscated to ensure best matching.
# Also for accurate matching populate with libraries (i.e. import from https://github.com/danielplohmann/mcrit-data dragging and dropping all the files for each into import, 
# or importing binaries and then editing them and marking them as libraries once imported).
[similarity]

# ============================================================
# Global options - apply to EVERY code-similarity engine (MCRIT + Kesakode)
# ============================================================

# Hard per-job deadline (seconds) so a stuck engine can't stall processing.
timeout = 120

# File sources to submit. Default is memory-extracted / unpacked files, which
# match best. Only formats an engine supports are sent (shellcode blobs and
# non-executables are skipped automatically).
similarity_payloads = yes
similarity_procdump = yes
similarity_dropped = no
similarity_submittedfile = no

# Skip artifacts already resolved to a known family. Set no to submit
# everything (corpus building / re-checking known files).
only_unidentified = yes

# --- Result selection (what is shown) ---
# Minimum similarity % for a match to appear in the report.
minimum_similarity = 50
# Max matches shown per artifact (top N by score).
max_results = 3
# Show matches that carry a family label / that don't (sha256 + score only).
match_families = yes
match_nofamily = yes
# If nothing clears minimum_similarity, still show the single best hit, flagged
# low-confidence.
best_match = no
# Comma-separated family substrings to suppress (case-insensitive).
# exclude_families = msvc,mingw
# Discard matches that are mostly shared library / runtime code, using an
# engine's non-library-weighted score where available (preferred over a long
# exclude_families list).
ignore_library_matches = yes

# --- Family classification (promote a match into CAPE detections) ---
# When yes, a strong family match is added to CAPE's detections list. Only for
# artifacts with no existing family; each family added at most once per run.
update_malfamily = no
# Separate, higher threshold for promotion (low-confidence matches can still
# show in the table without setting the malware family).
malfamily_minimum_similarity = 80
# top - only the single highest-similarity family per artifact
# all - every family clearing malfamily_minimum_similarity
malfamily_mode = top

# --- Concurrent submission ---
# Submit multiple artifacts at once; max_workers bounds simultaneous jobs.
# NOTE: the Malcat bridge serialises analyses on its side, so Kesakode is
# effectively one-at-a-time regardless; this mainly affects MCRIT.
concurrent_submissions = no
max_workers = 4

# ============================================================
# MCRIT (https://github.com/danielplohmann/mcrit)
# ============================================================
mcrit = yes
# Formats sent to MCRIT (SMDA supports pe, elf, macho; CAPE omits macho).
mcrit_formats = pe,elf
# REST API endpoint - the API (8000), NOT the web UI (5000).
mcrit_host = http://127.0.0.1:8000
mcrit_apitoken =
mcrit_username = cape
mcrit_poll_interval = 3
# no  - transient /query, nothing stored.
# yes - store via /samples/binary for corpus building (sha256 pre-check reuses).
persist_samples = no

# ============================================================
# Malcat Kesakode (via the Malcat bridge)
# ============================================================
# Kesakode identifies a sample's malware FAMILY by hashing its functions/
# strings/constants. It returns family LABELS (family -> score), not
# sample-to-sample links, so its matches carry a family + score but no
# matched-sample sha256. Reporting/placement is identical to MCRIT.
#
# Kesakode runs in Malcat's own venv, reached over the network via the Malcat
# bridge (like MCRIT's server). The bridge holds the Malcat license; CAPE only
# needs the bridge API key.
kesakode = no
kesakode_formats = pe,elf
# online  - query the live Kesakode service (spends monthly quota; returns
#           goodware labels too). Default while offline OEM support is finalised.
# offline - Malcat's local Kesakode DB (no quota; needs the OEM headless build).
# auto    - offline first, escalate to online only on a miss.
kesakode_mode = online
# On-demand (online only): when yes, the online lookup is NOT run during
# processing - it is deferred to a per-file button in the report, so you spend
# tokens only on the artifacts you choose. Offline always looks up (no limit),
# so this setting is ignored for offline/auto's offline stage.
kesakode_on_demand = no
# Stop online lookups once this many monthly tokens remain (quota floor), so a
# busy pipeline can't drain the month. Enforced by the bridge on live quota.
kesakode_quota_reserve = 10
# --- Bridge connection ---
kesakode_host = http://127.0.0.1:8090
kesakode_apikey =
# Verify the bridge TLS cert. no for a self-signed bridge on a trusted network.
kesakode_ssl_verify = no


# ============================================================
# Malcat static intel (anomalies, and the CAPA override) via the Malcat bridge
# ============================================================
# Non-similarity Malcat features. (Kesakode code similarity is configured in
# the [similarity] section, with the other similarity engines.) Enable the
# module too in processing.conf [malcat].
#
# Requires the Malcat bridge running alongside Malcat (see the bridge tool).
# The bridge holds the Malcat license; CAPE only needs the bridge API key.
[malcat]

# Per-artifact deadline talking to the bridge (seconds).
timeout = 120

# ---- Features ------------------------------------------------
# Pull Malcat's anomaly scanner results and show them in the expandable
# "Malcat" panel on each file's info card.
anomalies = yes

# ---- What to submit ------------------------------------------
# Which artifact types to send to Malcat for static intel. Unlike the
# similarity engine (which focuses on unpacked payloads), anomalies are useful
# across all submitted files. Only supported executable formats are sent;
# shellcode blobs and non-executables are skipped automatically.
malcat_payloads = yes
malcat_procdump = yes
malcat_dropped = no
malcat_submittedfile = no

# ---- Bridge connection ---------------------------------------
# Defaults to the same bridge as Kesakode; override here if the anomalies/CAPA
# bridge is a different instance. If blank, the [similarity] kesakode_host /
# kesakode_apikey / kesakode_ssl_verify values are reused.
malcat_host =
malcat_apikey =
malcat_ssl_verify = no
